{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpsAgent change analyst finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analyst",
    "status",
    "scope",
    "assessment",
    "changes",
    "claims",
    "evidence",
    "errors",
    "not_checked"
  ],
  "properties": {
    "analyst": {
      "const": "change-analyst"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "not_applicable",
        "failed"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server",
        "database",
        "object",
        "window_start",
        "window_end"
      ],
      "properties": {
        "server": {
          "type": [
            "string",
            "null"
          ]
        },
        "database": {
          "type": [
            "string",
            "null"
          ]
        },
        "object": {
          "type": [
            "string",
            "null"
          ]
        },
        "window_start": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "window_end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "confidence"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "moderate",
            "high"
          ]
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_id",
          "applied_at",
          "description",
          "affected_objects",
          "relevance",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CH[0-9]+$"
          },
          "source_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "applied_at": {
            "type": "string",
            "format": "date-time"
          },
          "description": {
            "type": "string"
          },
          "affected_objects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "relevance": {
            "type": "string",
            "enum": [
              "potentially_relevant",
              "no_obvious_relevance",
              "undetermined"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "statement",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^C[0-9]+$"
          },
          "type": {
            "type": "string",
            "enum": [
              "observation",
              "comparison",
              "inference",
              "hypothesis"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "source",
          "captured_at",
          "limitations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^E[0-9]+$"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "captured_at": {
            "type": "string",
            "format": "date-time"
          },
          "measurement_window": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "type": "string",
                "format": "date-time"
              },
              "end": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "query_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "value",
                "unit"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": [
                    "number",
                    "string",
                    "null"
                  ]
                },
                "unit": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "baseline": {
                  "type": [
                    "number",
                    "string",
                    "null"
                  ]
                },
                "observed": {
                  "type": [
                    "number",
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "message"
        ],
        "properties": {
          "stage": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "tool": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "not_checked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
